API_ENVIRONMENT=development
API_DATABASE_URL=postgresql+asyncpg://ai_inference:local@localhost:5432/ai_inference
API_INFERENCE_BASE_URL=http://localhost:9000
API_CORS_ORIGINS=["http://localhost:3000"]
API_JWT_SECRET_KEY=replace-with-a-long-random-secret
API_ACCESS_TOKEN_EXPIRE_MINUTES=480
API_AUTH_COOKIE_NAME=ai_session
API_AUTH_COOKIE_SECURE=false
API_AUTH_COOKIE_SAMESITE=lax
API_CONNECT_TIMEOUT_SECONDS=5
API_INFERENCE_TIMEOUT_SECONDS=300
